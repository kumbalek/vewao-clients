              "format": "",
              "indent": 0,
              "tag": "h2",
              "children": [
                {
                  "type": "text",
                  "version": 1,
                  "text": "Objevte léčivou sílu bylin a odvarů na míru",
                  "format": 0,
                  "detail": 0,
                  "mode": "normal",
                  "style": ""
                }
              ]
            },
            {
              "type": "paragraph",
              "version": 1,
