# Local development only. Dummy credentials load providers but cannot perform real payments, shipments or email.
# Medusa core
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vewao
REDIS_URL=redis://localhost:6379
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:8000,http://localhost:9000
JWT_SECRET=replace-with-a-long-random-value
COOKIE_SECRET=replace-with-a-long-random-value
MEDUSA_BACKEND_URL=http://localhost:9000

# Existing price-history plugin
FEATURE_COMPLIANCE=true
FEATURE_OMNIBUS=true
OMNIBUS_WINDOW_DAYS=30
PRICE_HISTORY_RETENTION_DAYS=1095

# By Judith: pay on site only with clinic pickup; delivery is paid via Comgate
FEATURE_PAY_ON_SITE_PICKUP_ONLY=true

# Comgate payment provider (provider id: pp_comgate_comgate)
FEATURE_COMGATE=true
COMGATE_MERCHANT=local-dev
COMGATE_SECRET=local-dev
COMGATE_TEST=true
COMGATE_PREAUTH=false
COMGATE_LANG=cs
COMGATE_COUNTRY=CZ
COMGATE_LABEL=By Judith
COMGATE_METHOD=ALL

# Packeta fulfillment provider (provider id: packeta_packeta). Off for By Judith:
# launch shipping is clinic pickup and PPL, fulfilled manually (2026-09-24).
FEATURE_PACKETA=false
PACKETA_API_PASSWORD=00000000000000000000000000000000
PACKETA_API_KEY=0000000000000000
PACKETA_ESHOP=localhost
PACKETA_WEBHOOK_SIGNING_KEY=
PACKETA_COD_PAYMENT_PROVIDERS=pp_system_default
PACKETA_ENABLED_CARRIERS=
PACKETA_EXPOSE_CARRIERS=true
PACKETA_VALIDATE_PICKUP_POINT=true
PACKETA_POLL_STATUS=false

# Optional admin-managed content, forms, and Postgres search
FEATURE_CONTENT=true
FEATURE_FORMS=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
FEATURE_SEARCH=true
# Comma-separated: category,collection. Products are always indexed.
SEARCH_SOURCES=category,collection
# PostgreSQL has no built-in Czech text search configuration; simple is safe.
SEARCH_LANGUAGE=simple
SEARCH_RESULT_LIMIT=12

# AWS SES notification provider (provider id: np_ses_ses)
FEATURE_SES=true
SES_REGION=eu-central-1
SES_ACCESS_KEY_ID=local-dev
SES_SECRET_ACCESS_KEY=local-dev
SES_FROM=dev@example.invalid
