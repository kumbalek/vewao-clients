{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Grafana Cloud Prometheus datasource for the By Judith dev collector",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    },
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "description": "Grafana Cloud Loki datasource for the By Judith dev collector",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "11.0.0"
    },
    {
      "type": "panel",
      "id": "logs",
      "name": "Logs",
      "version": ""
    },
    {
      "type": "datasource",
      "id": "loki",
      "name": "Loki",
      "version": ""
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": ""
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "text",
      "name": "Text",
      "version": ""
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    }
  ],
  "annotations": {
    "list": []
  },
  "description": "Operational overview for the By Judith dev shop. Unknown sections are intentionally explicit until their telemetry is implemented.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "panels": [],
      "title": "1. Status",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Internal /health probe from the Hetzner host. This does not prove public reachability.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": { "0": { "color": "red", "index": 0, "text": "Unhealthy" }, "1": { "color": "green", "index": 1, "text": "Healthy" } }, "type": "value" },
            { "options": { "match": "null", "result": { "color": "orange", "index": 2, "text": "Unknown" } }, "type": "special" }
          ],
          "noValue": "Unknown",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 5, "x": 0, "y": 1 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showPercentChange": false, "textMode": "value_and_name", "wideLayout": true },
      "pluginVersion": "11.0.0",
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "editorMode": "code", "expr": "max(probe_success{client=\"by-judith\", environment=\"$environment\", scope=\"internal\", service=\"platform\", check=\"health\"})", "instant": true, "legendFormat": "Platform API", "range": false, "refId": "A" }
      ],
      "title": "Platform API — internal",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Static storefront liveness from inside the Hetzner host. This is not backend-aware readiness or public reachability.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": { "0": { "color": "red", "index": 0, "text": "Unhealthy" }, "1": { "color": "green", "index": 1, "text": "Alive" } }, "type": "value" },
            { "options": { "match": "null", "result": { "color": "orange", "index": 2, "text": "Unknown" } }, "type": "special" }
          ],
          "noValue": "Unknown",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 5, "x": 5, "y": 1 },
      "id": 3,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showPercentChange": false, "textMode": "value_and_name", "wideLayout": true },
      "pluginVersion": "11.0.0",
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "editorMode": "code", "expr": "max(probe_success{client=\"by-judith\", environment=\"$environment\", scope=\"internal\", service=\"storefront\", check=\"static-liveness\"})", "instant": true, "legendFormat": "Storefront", "range": false, "refId": "A" }
      ],
      "title": "Storefront — static liveness",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Age of the newest node metric received by Grafana. More than five minutes is critical.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 0,
          "mappings": [ { "options": { "match": "null", "result": { "color": "orange", "index": 0, "text": "Unknown" } }, "type": "special" } ],
          "noValue": "Unknown",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 180 }, { "color": "red", "value": 300 } ] },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 5, "x": 10, "y": 1 },
      "id": 4,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showPercentChange": false, "textMode": "value_and_name", "wideLayout": true },
      "pluginVersion": "11.0.0",
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "editorMode": "code", "expr": "time() - max(timestamp(node_time_seconds{client=\"by-judith\", environment=\"$environment\"}))", "instant": true, "legendFormat": "Metric age", "range": false, "refId": "A" }
      ],
      "title": "Telemetry freshness",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Docker presence, running state and health for all four required Compose services. Missing is distinct from unhealthy.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": { "0": { "color": "red", "index": 0, "text": "Unhealthy" }, "1": { "color": "green", "index": 1, "text": "Healthy" }, "2": { "color": "orange", "index": 2, "text": "Missing" } }, "type": "value" },
            { "options": { "match": "null", "result": { "color": "gray", "index": 3, "text": "Unknown" } }, "type": "special" }
          ],
          "noValue": "Unknown",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 }, { "color": "orange", "value": 2 } ] }
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 9, "x": 15, "y": 1 },
      "id": 5,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showPercentChange": false, "textMode": "value_and_name", "wideLayout": true },
      "pluginVersion": "11.0.0",
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "editorMode": "code", "expr": "2 * (max by (service) (vewao_container_present{client=\"by-judith\", environment=\"$environment\", service=~\"platform|storefront|postgres|redis\"}) == bool 0) + (max by (service) (vewao_container_present{client=\"by-judith\", environment=\"$environment\", service=~\"platform|storefront|postgres|redis\"}) == bool 1) * max by (service) (vewao_container_running{client=\"by-judith\", environment=\"$environment\", service=~\"platform|storefront|postgres|redis\"}) * max by (service) (vewao_container_health_status{client=\"by-judith\", environment=\"$environment\", service=~\"platform|storefront|postgres|redis\", status=\"healthy\"})", "instant": true, "legendFormat": "{{service}}", "range": false, "refId": "A" }
      ],
      "title": "Required service state",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "id": 6,
      "panels": [],
      "title": "2. Deployments",
      "type": "row"
    },
    {
      "description": "Deployment journal ingestion is a later increment.",
      "gridPos": { "h": 5, "w": 9, "x": 0, "y": 7 },
      "id": 7,
      "options": {
        "code": { "language": "plaintext", "showLineNumbers": false, "showMiniMap": false },
        "content": "### Deployment journal not collected\n\nCurrent running images are live in the adjacent panel. Latest attempt, commit SHA, result, duration and GitHub run link remain **unknown** until the append-only deployment journal is shipped to Loki.",
        "mode": "markdown"
      },
      "pluginVersion": "11.0.0",
      "title": "Release state",
      "type": "text"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Live image reference reported by Docker for each required service. This proves what is running, not which workflow produced it.",
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" }, "mappings": [], "noValue": "Unknown", "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": null } ] } }, "overrides": [] },
      "gridPos": { "h": 5, "w": 15, "x": 9, "y": 7 },
      "id": 22,
      "options": { "colorMode": "none", "graphMode": "none", "justifyMode": "auto", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showPercentChange": false, "textMode": "name", "wideLayout": true },
      "pluginVersion": "11.0.0",
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "editorMode": "code", "expr": "vewao_container_info{client=\"by-judith\", environment=\"$environment\", service=~\"platform|storefront|postgres|redis\"}", "instant": true, "legendFormat": "{{service}} — {{image_ref}}", "range": false, "refId": "A" } ],
      "title": "Current running images",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 12 },
      "id": 8,
      "panels": [],
      "title": "3. Logs",
      "type": "row"
    },
    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "description": "Application log volume by Compose service.",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "hideFrom": { "legend": false, "tooltip": false, "viz": false }, "lineInterpolation": "linear", "lineWidth": 1, "pointSize": 5, "scaleDistribution": { "type": "linear" }, "showPoints": "never", "spanNulls": false, "stacking": { "group": "A", "mode": "normal" }, "thresholdsStyle": { "mode": "off" } }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }, "unit": "logsps" },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 13 },
      "id": 9,
      "options": { "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "hideZeros": false, "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "loki", "uid": "${DS_LOKI}" }, "editorMode": "code", "expr": "sum by (service) (rate({client=\"by-judith\", environment=\"$environment\", service=~\"$service\"}[$__interval]))", "legendFormat": "{{service}}", "queryType": "range", "refId": "A" }
      ],
      "title": "Log rate by service",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "description": "Heuristic text match for application errors. Inspect the log stream before treating this as an incident count.",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "bars", "fillOpacity": 40, "gradientMode": "none", "hideFrom": { "legend": false, "tooltip": false, "viz": false }, "lineInterpolation": "linear", "lineWidth": 1, "pointSize": 5, "scaleDistribution": { "type": "linear" }, "showPoints": "never", "spanNulls": false, "stacking": { "group": "A", "mode": "normal" }, "thresholdsStyle": { "mode": "off" } }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 13 },
      "id": 10,
      "options": { "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "hideZeros": false, "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "loki", "uid": "${DS_LOKI}" }, "editorMode": "code", "expr": "sum by (service) (count_over_time({client=\"by-judith\", environment=\"$environment\", service=~\"$service\"} |~ `(?i)(error|exception|fatal|panic)` [$__interval]))", "legendFormat": "{{service}}", "queryType": "range", "refId": "A" }
      ],
      "title": "Error-like log lines",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "description": "Docker logs from the By Judith dev Compose project only. Use the service variable to narrow the stream.",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 20 },
      "id": 11,
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": false, "showCommonLabels": false, "showLabels": false, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true },
      "targets": [
        { "datasource": { "type": "loki", "uid": "${DS_LOKI}" }, "editorMode": "code", "expr": "{client=\"by-judith\", environment=\"$environment\", service=~\"$service\"}", "queryType": "range", "refId": "A" }
      ],
      "title": "Application logs",
      "type": "logs"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
      "id": 12,
      "panels": [],
      "title": "4. Capacity",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "decimals": 1, "max": 100, "min": 0, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 75 }, { "color": "red", "value": 90 } ] }, "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 33 },
      "id": 13,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showPercentChange": false, "textMode": "value_and_name", "wideLayout": true },
      "pluginVersion": "11.0.0",
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "editorMode": "code", "expr": "100 - (avg(rate(node_cpu_seconds_total{client=\"by-judith\", environment=\"$environment\", mode=\"idle\"}[$__rate_interval])) * 100)", "instant": false, "legendFormat": "CPU busy", "range": true, "refId": "A" } ],
      "title": "Host CPU busy",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "decimals": 1, "max": 100, "min": 0, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "orange", "value": 10 }, { "color": "green", "value": 20 } ] }, "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 33 },
      "id": 14,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showPercentChange": false, "textMode": "value_and_name", "wideLayout": true },
      "pluginVersion": "11.0.0",
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "editorMode": "code", "expr": "100 * node_memory_MemAvailable_bytes{client=\"by-judith\", environment=\"$environment\"} / node_memory_MemTotal_bytes{client=\"by-judith\", environment=\"$environment\"}", "instant": false, "legendFormat": "Memory available", "range": true, "refId": "A" } ],
      "title": "Host memory available",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "decimals": 1, "max": 100, "min": 0, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "orange", "value": 15 }, { "color": "green", "value": 25 } ] }, "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 33 },
      "id": 15,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showPercentChange": false, "textMode": "value_and_name", "wideLayout": true },
      "pluginVersion": "11.0.0",
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "editorMode": "code", "expr": "100 * node_filesystem_avail_bytes{client=\"by-judith\", environment=\"$environment\", mountpoint=\"/\"} / node_filesystem_size_bytes{client=\"by-judith\", environment=\"$environment\", mountpoint=\"/\"}", "instant": false, "legendFormat": "Disk free", "range": true, "refId": "A" } ],
      "title": "Root filesystem free",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "decimals": 1, "max": 100, "min": 0, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "orange", "value": 15 }, { "color": "green", "value": 25 } ] }, "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 33 },
      "id": 16,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showPercentChange": false, "textMode": "value_and_name", "wideLayout": true },
      "pluginVersion": "11.0.0",
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "editorMode": "code", "expr": "100 * node_filesystem_files_free{client=\"by-judith\", environment=\"$environment\", mountpoint=\"/\"} / node_filesystem_files{client=\"by-judith\", environment=\"$environment\", mountpoint=\"/\"}", "instant": false, "legendFormat": "Inodes free", "range": true, "refId": "A" } ],
      "title": "Root inodes free",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 8, "gradientMode": "none", "hideFrom": { "legend": false, "tooltip": false, "viz": false }, "lineInterpolation": "linear", "lineWidth": 1, "pointSize": 5, "scaleDistribution": { "type": "linear" }, "showPoints": "never", "spanNulls": false, "stacking": { "group": "A", "mode": "none" }, "thresholdsStyle": { "mode": "off" } }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] } }, "overrides": [] },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 39 },
      "id": 17,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "hideZeros": false, "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "editorMode": "code", "expr": "node_load1{client=\"by-judith\", environment=\"$environment\"}", "legendFormat": "1 minute", "range": true, "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "editorMode": "code", "expr": "node_load5{client=\"by-judith\", environment=\"$environment\"}", "legendFormat": "5 minutes", "range": true, "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "editorMode": "code", "expr": "node_load15{client=\"by-judith\", environment=\"$environment\"}", "legendFormat": "15 minutes", "range": true, "refId": "C" }
      ],
      "title": "Host load average",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Docker restart count for the current container instance. Recreating a container resets this value.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "decimals": 0, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 3 } ] }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 12, "x": 0, "y": 46 },
      "id": 23,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showPercentChange": false, "textMode": "value_and_name", "wideLayout": true },
      "pluginVersion": "11.0.0",
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "editorMode": "code", "expr": "vewao_container_restart_count{client=\"by-judith\", environment=\"$environment\", service=~\"platform|storefront|postgres|redis\"}", "instant": false, "legendFormat": "{{service}}", "range": true, "refId": "A" } ],
      "title": "Container restarts",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Sticky OOM-killed state for each current container instance.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "mappings": [ { "options": { "0": { "color": "green", "index": 0, "text": "Clear" }, "1": { "color": "red", "index": 1, "text": "OOM killed" } }, "type": "value" } ], "noValue": "Unknown", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] },
