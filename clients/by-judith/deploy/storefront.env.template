# Storefront runtime secrets (server only, chmod 600). Payload CMS runs inside
# the storefront (D22); its database URL comes from compose.yaml.
PAYLOAD_SECRET=
# First admin, created on start only while the CMS has no users. Without it,
# whoever opens /admin first could create the admin. Remove both after the
# first start and change the password in the admin.
CMS_INITIAL_ADMIN_EMAIL=
CMS_INITIAL_ADMIN_PASSWORD=
# Optional: CMS images on S3 (same bucket as Medusa, own prefix). Empty: the
# cms-media volume.
CMS_S3_BUCKET=
CMS_S3_REGION=
CMS_S3_ENDPOINT=
CMS_S3_ACCESS_KEY_ID=
CMS_S3_SECRET_ACCESS_KEY=
CMS_S3_PREFIX=cms
CMS_S3_FORCE_PATH_STYLE=false
