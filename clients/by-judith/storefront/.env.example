# Local/test backend only. Create a publishable key in the new Medusa admin.
MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_replace_with_local_publishable_key
NEXT_PUBLIC_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_REGION=cz
# Runtime, production only. Any other value sends X-Robots-Tag: noindex.
ALLOW_INDEXING=false
# Google Analytics 4 measurement ID (G-…). Empty: no analytics and no consent banner.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
