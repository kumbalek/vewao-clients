# Local/test backend only. Create a publishable key in the new Medusa admin.
MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_replace_with_local_publishable_key
NEXT_PUBLIC_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_REGION=cz
# Runtime, production only. Any other value sends X-Robots-Tag: noindex.
ALLOW_INDEXING=false
# Google Analytics 4 measurement ID (G-…). Empty: no analytics and no consent banner.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Payload CMS inside the storefront (D22): its own Postgres database, migrated
# with `pnpm payload migrate`. Admin at /admin.
PAYLOAD_DATABASE_URL=postgres://user:password@localhost:5433/cms
PAYLOAD_SECRET=
# First admin when the CMS has no users (see deploy/storefront.env.template)
CMS_INITIAL_ADMIN_EMAIL=
CMS_INITIAL_ADMIN_PASSWORD=
